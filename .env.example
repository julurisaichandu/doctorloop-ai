# DoctorLoop AI — copy to .env.local and fill in what you have.
# Every integration is optional: without credentials the app uses clearly labeled
# mock / simulated / local-demo fallbacks, so the full demo works with this file empty.
# Synthetic data only — never put real patient data into this prototype.

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs sessions. REQUIRED in production (at least 32 characters); the app refuses to run without it.
# In development a random secret is created in .data/dev-session-secret. Generate: openssl rand -base64 48
SESSION_SECRET=
# Encrypts Vexo OAuth tokens at rest. REQUIRED when VEXO_MODE=live in production;
# otherwise a separate key is derived from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=
# Development-only demo role switcher. Default: on in development, off in production.
# Enabling it in a deployed build lets anyone sign in as the fictional demo accounts.
ENABLE_DEMO_ROLE_SWITCHER=

# --- Supabase (database + auth + row-level security) -------------------------
# Leave empty to use the local demo database (.data/local-db.json).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server-only; bypasses RLS.
SUPABASE_SECRET_KEY=
# REQUIRED for the Supabase seed script (at least 12 characters) and for the demo account
# switcher in Supabase mode. No default. Assigned to every fictional demo account.
DEMO_ACCOUNT_PASSWORD=

# --- OpenAI (structured extraction + summaries, run inside the Mastra workflow) ---
# Leave empty to use the deterministic rule-based mock AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Pipecat voice agent (voice check-in calls; replaces ElevenLabs when set) -
# URL of the Pipecat voice agent in voice-agent/, e.g. http://localhost:7860
PIPECAT_VOICE_URL=

# --- ElevenLabs Conversational AI (voice check-ins) --------------------------
# Leave empty for the clearly labeled simulated check-in.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Post-call webhook HMAC secret (from the ElevenLabs webhook settings).
ELEVENLABS_WEBHOOK_SECRET=

# --- Vexo MCP (wearable memories, read-only) ---------------------------------
# mock = fictional sample memories (default). live = real OAuth 2.1 + PKCE connector.
# file = replay a predefined band capture file (no band needed); see vexo-band/README.md.
VEXO_MODE=mock
# Band file replayed when VEXO_MODE=file (relative to the project root, or absolute).
VEXO_FILE_PATH=vexo-band/maya-band-capture.txt
VEXO_MCP_URL=https://api.vexoai.com/mcp
# Only needed if Vexo issues you a client (otherwise dynamic client registration is attempted).
VEXO_CLIENT_ID=
VEXO_CLIENT_SECRET=
VEXO_SCOPES=vexo:read
VEXO_REDIRECT_URI=http://localhost:3000/api/integrations/vexo/callback

# --- Vexo band push (local Pipecat bridge, see band-bridge/README.md) --------
# The bridge POSTs each kept conversation, HMAC-signed, to /api/integrations/vexo/band.
# Band ingest is on only when all three are valid; the bridge needs the same number and secret.
# The one band number accepted (1..999).
VEXO_BAND_NUMBER=47
# Shared HMAC secret, at least 32 characters. Generate: openssl rand -hex 32
VEXO_BAND_SECRET=
# E-mail of the patient account that wears the band (a demo account).
VEXO_BAND_WEARER=maya.thompson@example.com

# Read by band-bridge/ only, not by Next:
# Deepgram speech-to-text (audio from the band goes to Deepgram).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINTING_MS=100
# Gemini Decisions privacy gate on the laptop (text goes to Google). Without a key a rule-based gate runs.
GEMINI_API_KEY=
# Keep a conversation only if P(very private) < GATE_PRIVATE_MAX and P(health related) >= GATE_HEALTH_MIN.
GATE_PRIVATE_MAX=0.5
GATE_HEALTH_MIN=0.5

# --- Stripe (practice billing, TEST MODE ONLY) -------------------------------
# Doctors are billed for AI token usage; patients never are. Without a test key the app
# runs a clearly labeled simulated billing mode. Live keys (sk_live_/rk_live_) are ignored.
STRIPE_SECRET_KEY=
# Webhook signing secret: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and paste the printed whsec_... value.
STRIPE_WEBHOOK_SECRET=
# USD per 1,000 tokens (default 0.01).
BILLING_PRICE_PER_1K_TOKENS_USD=0.01
